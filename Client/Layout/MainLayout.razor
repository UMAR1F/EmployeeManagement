

@layout MainLayout
@inherits LayoutComponentBase

@attribute [Authorize] 

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
          <ProfileDropDown></ProfileDropDown>
          

        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div> 


<Syncfusion.Blazor.Popups.SfDialogProvider/>


@code{
    async Task logoutClicked()
    {
        var logOutModel = new UserSession();
        var customerAuthStateProvider = (CustomAuthentificationStateProvider)AuthStateProvider;
        await customerAuthStateProvider.UpdateAuthentificationState(logOutModel);
        NavManager.NavigateTo("/", forceLoad: true);


    }
}


