@page "/identity/account/login"
@layout AuthentificationLayout;



<div class="container">
    <div class="row">
        <div class="col-lg-4"></div>
        <div class="col-lg-4">
            <EditForm Model="@User" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />
         
                <div class="card bg-dark" style="opacity:0.5; margin-top:50%; border-radius:10px; color:white; font-weight:bold;" >
                    <div class="card-header text-center fs-5 mb-2">Fill This Login Form</div>
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-4 col-md-4 col-se-4"></div>
                            <div class="col-lg-4 col-md-4 col-se-4 d-flex justify-content-center">
                                <img style="border-radius:20px" src="../Images/Logo/logo.jpg" height="50" width="50"/>
                            </div>
                            <div class="col-lg-4 col-md-4 col-se-4"></div>
                   </div>
                    </div>
                    <div class="card-body">
                        <div class="form-group-mt-3">
                            <label class="form-label">Email</label>
                            <InputText @bind-Value="User.Email" class="form-control" />
                        </div>
                        <div class="form-group-mt-3">
                            <label class="form-label">Password</label>
                            <InputText @bind-Value="User.Password" class="form-control" type="password" />
                        </div>
                        <p></p>
                        @if(ShowLoadingButton)
                        {

                            <BtuttonLoadingSpinner></BtuttonLoadingSpinner>
                        }
                        else
                        { 
                            <button class="btn btn-outline-primary float-end" type="submit">Login</button>
                        }
                                            
                    </div>
                    <div class="card-footer">
                        <span class="text-center">
                            Don't have an account? |
                            <a class="btn-link" href="/identity/account/register">Sign Up</a>
                        </span>
                        <ValidationSummary/>
                    </div>
                </div>
            </EditForm>
        </div>
        <div class="col-lg-4"></div>
    </div>
</div>






@code {
    public bool ShowLoadingButton { get; set; } = false;
    Login User = new();
    [CascadingParameter]
    public Task<AuthenticationState> AuthenticationState { get; set; }

   

    protected async override Task OnInitializedAsync()
    {
        await CheckUserAuthentication();
    }
    async Task HandleLogin()
    {
        var result = await accountService.SignInAsync(User);
        if (result.Flag){
           await DisplayDialog(result.Messsage, "Login Successfull");

            var customerAuthStateProvider = (CustomAuthentificationStateProvider)AuthStateProvider;
            await customerAuthStateProvider.UpdateAuthentificationState(new UserSession()
                            {
                              Token = result.Token,
                              RefreshToken = result.RefreshToken
                          });
            NavManager.NavigateTo("/", forceLoad: true);
        }
        else
        {
           await DisplayDialog(result.Messsage, "Alert");
        }
        ShowLoadingButton = false;
    }

    private async Task DisplayDialog(string content, string title)
     {
        await DialogService.AlertAsync(content, title);
    }

     private async Task CheckUserAuthentication()
    {
        var user = (await AuthenticationState).User;
        bool IsuserAuthentificated = user.Identity!.IsAuthenticated;
        if (IsuserAuthentificated) NavManager.NavigateTo("home/dashboard");

    }
  
}